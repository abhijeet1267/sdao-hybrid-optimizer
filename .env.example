# Copy to .env for local use, or export these variables in your shell.
# Do not commit a real .env file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sdao
POSTGRES_USER=sdao
POSTGRES_PASSWORD=change-me

# pgvector benchmark settings (documented defaults; not claimed optimal).
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=200
PGVECTOR_HNSW_EF_SEARCH=100
PGVECTOR_IVFFLAT_LISTS=1000
PGVECTOR_IVFFLAT_PROBES=10
SDAO_DB_BATCH_SIZE=1000
